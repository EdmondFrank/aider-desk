{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aiderdesk/extensions": ["../../extensions.d.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "__tests__"]
}
